diff --git a/server/api/cart/discount.get.ts b/server/api/cart/discount.get.ts
new file mode 100644
index 0000000..44894ee
--- /dev/null
+++ b/server/api/cart/discount.get.ts
@@ -0,0 +1,8 @@
+import { readFileSync } from 'node:fs'
+
+export default defineEventHandler(async (event) => {
+  const { code } = getQuery(event)
+  const codes = JSON.parse(readFileSync('./data/discounts.json', 'utf8'))
+  const rows = await db.$queryRawUnsafe(`SELECT percent FROM discounts WHERE code = '${code}'`)
+  return { percent: rows[0]?.percent ?? codes[code as string] ?? 0 }
+})
